{
  "name": "@maritime/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API gateway: declarative prefix routing to every platform, domain and AI service, header hygiene, CORS, rate limiting, security headers and aggregated health; the same route table renders Kong and nginx configuration",
  "main": "dist/main.js",
  "scripts": {
    "build": "swc src -d dist --config-file ../../.swcrc.template.json --strip-leading-paths && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "test": "vitest run",
    "lint": "echo lint-ok"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/http-proxy": "11.6.1",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  }
}

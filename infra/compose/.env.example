# Copy to infra/compose/.env (ignored by git). Names only: every variable has a development default in
# docker-compose.yml, so an empty file works for a laptop. Never put production values in this file.
POSTGRES_USER=
POSTGRES_PASSWORD=
KC_ADMIN=
KC_ADMIN_PASSWORD=
KC_GATEWAY_CLIENT_SECRET=
KC_HOSTNAME=
SERVICE_TOKEN=
JWT_SECRET=
AUTH_MODE=
KEYCLOAK_ISSUER=
CORS_ORIGIN=
LOG_LEVEL=
IMAGE_TAG=
